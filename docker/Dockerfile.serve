FROM python:3.11-slim
WORKDIR /app

# Install curl for the HEALTHCHECK
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

COPY requirements/serve.txt .
RUN pip install --no-cache-dir -r serve.txt

COPY src/ ./src/

# Create and switch to a non-root user for security
RUN useradd -m serveuser
RUN chown -R serveuser:serveuser /app
USER serveuser

ENV PYTHONUNBUFFERED=1
EXPOSE 8080

# Healthcheck hitting the FastAPI /health endpoint
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["uvicorn", "src.serve:app", "--host", "0.0.0.0", "--port", "8080"]